#!/usr/bin/python3.11
"""Burn-scar map of one HLS scene with Prithvi-EO 2.0's burn-scar model.

Implements entrypoint contract v1 (fossettlab/geospatial-executor,
docs/contracts/entrypoint-v1.md): exactly three options, the scene staged under
``<input-dir>/primary/``, and every artifact plus ``run.json`` written under
``<output-dir>``.

The model is ``ibm-nasa-geospatial/Prithvi-EO-2.0-300M-BurnScars``, loaded as
its own ``inference.py`` loads it (TerraTorch's ``LightningInferenceModel``, from
its ``burn_scars_config.yaml`` and checkpoint, both baked into the image), and
run as that script runs it: reflectance divided by 10,000, the scene
reflect-padded to whole 512-pixel windows, each window normalized by the
datamodule's own transforms, and the argmax of the two classes.
"""

from __future__ import annotations

import argparse
import hashlib
import importlib.metadata as im
import json
import sys
from dataclasses import asdict, dataclass
from pathlib import Path
from typing import Any

import numpy as np
import rasterio
import rasterio.shutil
import torch
import yaml

CONTRACT_VERSION = 1

WEIGHTS_DIR = Path("/opt/weights")
CHECKPOINT = WEIGHTS_DIR / "Prithvi_EO_V2_300M_BurnScars.pt"
CONFIG = WEIGHTS_DIR / "burn_scars_config.yaml"
PROVENANCE = WEIGHTS_DIR / "provenance.json"

# HLS v2.0: reflectance x 10000 in int16, fill -9999 (HLS v2.0 user guide), in
# the band order the model was trained on (the config's dataset_bands).
BANDS = ("BLUE", "GREEN", "RED", "NIR_NARROW", "SWIR_1", "SWIR_2")
HLS_SCALE = 10000.0
HLS_NODATA = -9999
# The training config replaced nodata in the image with 0 (no_data_replace).
NO_DATA_REPLACE = 0.0
# The model's own window, as its inference.py sets it (img_size = 512).
WINDOW = 512
CLASS_NAMES = ("not_burned", "burn_scar")  # the config's class_names, in order
PALETTE = {0: (230, 230, 230), 1: (200, 30, 30)}
NODATA_CODE = 255
KNOWN_PARAMS: set[str] = set()

TOLERANCE = 1e-6
COG_OPTIONS = {"driver": "COG", "compress": "deflate", "overview_resampling": "nearest"}
MAP_FILE, MAP_ROLE = "burn_scars.tif", "burn_scars"
REPORT_FILE, REPORT_ROLE = "burn_scars_report.json", "report"


class Refused(Exception):
    """Input or parameters this recipe will not run on; the message is for the caller."""


@dataclass(frozen=True)
class Grid:
    crs: str
    cell_x: float
    cell_y: float
    width: int
    height: int
    bounds: tuple[float, float, float, float]  # xmin, ymin, xmax, ymax


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="prithvi-burn-scars", allow_abbrev=False)
    parser.add_argument("--input-dir", required=True, type=Path)
    parser.add_argument("--output-dir", required=True, type=Path)
    parser.add_argument("--params-json", required=True, type=Path)
    return parser.parse_args(argv)


def read_params(path: Path) -> None:
    raw = json.loads(path.read_text())
    if not isinstance(raw, dict):
        raise Refused("params.json must hold a JSON object")
    unknown = sorted(set(raw) - KNOWN_PARAMS)
    if unknown:
        raise Refused(f"unknown parameters {unknown}; this task takes none")


def find_scene(input_dir: Path) -> Path:
    candidates = sorted((input_dir / "primary").glob("*.tif")) + sorted(
        (input_dir / "primary").glob("*.tiff")
    )
    if len(candidates) != 1:
        raise Refused(
            f"expected exactly one GeoTIFF under {input_dir / 'primary'}, found {len(candidates)}"
        )
    return candidates[0]


def describe(dataset: rasterio.DatasetReader) -> Grid:
    if dataset.count != len(BANDS):
        raise Refused(
            f"expected a 6-band HLS scene ({', '.join(BANDS)}), got {dataset.count} bands; "
            "the satellite fetch task's hls product writes one"
        )
    if any(dtype != "int16" for dtype in dataset.dtypes):
        raise Refused(f"expected int16 HLS reflectance x 10000, got {sorted(set(dataset.dtypes))}")
    if dataset.crs is None or not dataset.crs.is_projected:
        raise Refused("the scene must be in a projected CRS with cells in meters")
    unit = dataset.crs.linear_units_factor[1]
    if abs(unit - 1.0) > TOLERANCE:
        raise Refused(f"the scene's CRS unit is not the meter (factor {unit})")
    transform = dataset.transform
    return Grid(
        crs=dataset.crs.to_string(),
        cell_x=abs(transform.a),
        cell_y=abs(transform.e),
        width=dataset.width,
        height=dataset.height,
        bounds=tuple(dataset.bounds),
    )


def load_model(device: torch.device) -> tuple[Any, Any]:
    """The task model and its datamodule, as the model's own inference.py builds them."""
    from terratorch.cli_tools import LightningInferenceModel

    lightning_model = LightningInferenceModel.from_config(str(CONFIG), str(CHECKPOINT))
    model = lightning_model.model.to(device).eval()
    return model, lightning_model.datamodule


@torch.no_grad()
def classify(
    reflectance: np.ndarray, model: Any, datamodule: Any, device: torch.device
) -> np.ndarray:
    """Class index per pixel of a (bands, rows, cols) reflectance array, in 512-pixel windows."""
    _, height, width = reflectance.shape
    pad_h, pad_w = (-height) % WINDOW, (-width) % WINDOW
    padded = np.pad(reflectance, ((0, 0), (0, pad_h), (0, pad_w)), mode="reflect")
    out = np.zeros(padded.shape[1:], dtype=np.uint8)
    for row in range(0, padded.shape[1], WINDOW):
        for col in range(0, padded.shape[2], WINDOW):
            window = padded[:, row : row + WINDOW, col : col + WINDOW]
            sample = datamodule.test_transform(image=window.transpose(1, 2, 0))
            sample["image"] = sample["image"].unsqueeze(0)
            batch = datamodule.aug(sample)["image"].to(device)
            logits = model(batch).output
            out[row : row + WINDOW, col : col + WINDOW] = (
                logits.argmax(dim=1)[0].to(torch.uint8).cpu().numpy()
            )
    return out[:height, :width]


def write_map(path: Path, classes: np.ndarray, profile: dict[str, Any]) -> None:
    staging = path.with_suffix(".staging.tif")
    with rasterio.open(staging, "w", **profile) as dst:
        # The color table goes before the pixels: GTiff fixes the photometric
        # tag once data is written.
        dst.write_colormap(1, PALETTE)
        dst.write(classes, 1)
        dst.update_tags(1, **{f"class_{code}": name for code, name in enumerate(CLASS_NAMES)})
    rasterio.shutil.copy(staging, path, **COG_OPTIONS)
    staging.unlink()


def summary(classes: np.ndarray, grid: Grid) -> dict[str, Any]:
    cell_area = grid.cell_x * grid.cell_y
    valid = int((classes != NODATA_CODE).sum())
    burned = int((classes == 1).sum())
    return {
        "valid_pixels": valid,
        "nodata_pixels": int(classes.size - valid),
        "burned_pixels": burned,
        "burned_area_ha": round(burned * cell_area / 10_000, 3),
        "burned_fraction": round(burned / valid, 6) if valid else None,
    }


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def run(input_dir: Path, output_dir: Path) -> None:
    scene = find_scene(input_dir)
    with rasterio.open(scene) as dataset:
        grid = describe(dataset)
        raw = dataset.read()
        profile = {
            "driver": "GTiff",
            "width": dataset.width,
            "height": dataset.height,
            "count": 1,
            "dtype": "uint8",
            "crs": dataset.crs,
            "transform": dataset.transform,
            "nodata": NODATA_CODE,
        }
    missing = (raw == HLS_NODATA).any(axis=0)
    if missing.all():
        raise Refused("every pixel of the scene is nodata")
    reflectance = np.where(raw == HLS_NODATA, NO_DATA_REPLACE, raw / HLS_SCALE).astype(np.float32)

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model, datamodule = load_model(device)
    classes = classify(reflectance, model, datamodule, device)
    classes[missing] = NODATA_CODE

    output_dir.mkdir(parents=True, exist_ok=True)
    write_map(output_dir / MAP_FILE, classes, profile)
    config = yaml.safe_load(CONFIG.read_text())
    report = {
        "input": scene.name,
        "grid": asdict(grid),
        "classes": {str(code): name for code, name in enumerate(CLASS_NAMES)}
        | {str(NODATA_CODE): "nodata"},
        **summary(classes, grid),
        "model": {
            "name": "Prithvi-EO-2.0-300M-BurnScars",
            "weights": json.loads(PROVENANCE.read_text()),
            "window_px": WINDOW,
            "normalization": {
                "means": config["data"]["init_args"]["means"],
                "stds": config["data"]["init_args"]["stds"],
            },
        },
        "nodata": (
            f"a pixel with any band at {HLS_NODATA} is written as {NODATA_CODE}; its "
            f"reflectance goes into the model as {NO_DATA_REPLACE:g}, as in training"
        ),
        "clouds": "not masked: the model was trained with clouds labeled as no data, and "
        "the map may call cloud edges burn scars; check the fetch report's quality layer",
        "device": torch.cuda.get_device_name(device) if device.type == "cuda" else "cpu",
        "versions": {
            package: im.version(package) for package in ("terratorch", "torch", "rasterio")
        },
    }
    (output_dir / REPORT_FILE).write_text(json.dumps(report, indent=2) + "\n")

    # The manifest goes last: its presence is what says the run finished.
    outputs = [(MAP_FILE, MAP_ROLE, "GTiff"), (REPORT_FILE, REPORT_ROLE, None)]
    manifest = {
        "contract_version": CONTRACT_VERSION,
        "outputs": [
            {"path": name, "role": role, "sha256": sha256(output_dir / name)}
            | ({"format": fmt} if fmt else {})
            for name, role, fmt in outputs
        ],
    }
    (output_dir / "run.json").write_text(json.dumps(manifest, indent=2) + "\n")


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    try:
        read_params(args.params_json)
        run(args.input_dir, args.output_dir)
    except Refused as exc:
        print(f"prithvi-burn-scars: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
