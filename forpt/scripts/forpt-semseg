#!/usr/bin/env python
"""Label every point of a LAS/LAZ file as ground, wood or leaf with ForPT fine-tuned on FOR-instanceV2.

    forpt-semseg <input.las|.laz> <output.las|.laz>

The output is the input with one extra dimension, forpt_class (0 ground, 1 wood,
2 leaf); every other field is unchanged. Coordinates must be in meters. The whole
file goes through the model in one pass, as in upstream's tester, so GPU memory
sets the largest file that fits.
"""

import argparse
import sys
from pathlib import Path

import forpt_lib as fl
import laspy
import numpy as np
import torch

DIMENSION = "forpt_class"
DESCRIPTION = "ForPT: 0 ground 1 wood 2 leaf"


def predict(points: np.ndarray, model: torch.nn.Module, transform, device: str) -> np.ndarray:
    fl.seed_everything()
    batch = fl.model_input(points, transform, device)
    with torch.no_grad():
        logits = model(batch)["seg_logits"]
    # The model labels one point per 5 cm voxel; inverse maps every input point to its voxel.
    return logits.argmax(1)[batch["inverse"]].cpu().numpy().astype(np.uint8)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("input", type=Path)
    parser.add_argument("output", type=Path)
    args = parser.parse_args()

    las = laspy.read(args.input)
    if DIMENSION in las.point_format.extra_dimension_names:
        sys.exit(f"{args.input} already has a {DIMENSION} dimension")
    device = fl.require_cuda()
    model = fl.build_task_model(fl.SEMSEG, device)
    points = np.column_stack([las.x, las.y, las.z])
    labels = predict(points, model, fl.test_transform(fl.SEMSEG), device)

    las.add_extra_dim(laspy.ExtraBytesParams(name=DIMENSION, type=np.uint8, description=DESCRIPTION))
    las[DIMENSION] = labels
    args.output.parent.mkdir(parents=True, exist_ok=True)
    las.write(args.output)

    names = fl.class_names(fl.SEMSEG)
    counts = np.bincount(labels, minlength=len(names))
    summary = ", ".join(f"{name} {n:,}" for name, n in zip(names, counts))
    print(f"{args.input.name}: {len(labels):,} points -> {summary}; wrote {args.output}")


if __name__ == "__main__":
    main()
