#!/usr/bin/env python
"""Predict dry-stone wall masks for paired MHS and VAT tiles with a DINO-CV checkpoint.

This follows upstream's main_pred.py step for step: each tile is read with
upstream's tiff_to_arr, resized to 256 px (bicubic), normalized with ImageNet
statistics, passed through the two-view model, thresholded at --conf after a
sigmoid, resized back to the tile's size (nearest), written as a GeoTIFF with
the tile's CRS and transform, sieved with gdal_sieve (8-connected, --sieve
pixels), and deleted if nothing is left. Defaults (--conf 0.5, --sieve 100,
--area area3) are upstream's.

It differs from main_pred.py in three ways, none of which changes a prediction:
it needs no rgb/ folder (upstream's dataset class insists on one but the model
never reads it); it builds the encoders without loading the pretrained DINO-CV
backbones, since the fine-tuned checkpoint carries every weight; and it loads
that checkpoint strictly, after checking its SHA-256, where upstream loads
with strict=False and would ignore a mismatched key.
"""

import argparse
import hashlib
import sys
from pathlib import Path

import numpy as np
import rasterio as rio
import torch
import torchvision.transforms as T
import torchvision.transforms.functional as TF
import yaml
from osgeo_utils.gdal_sieve import gdal_sieve
from torchvision import models as torchvision_models

import model.backbone.vision_transformer as vits
from data.data_utils import arr_to_tiff, tiff_to_arr
from model.segmentation import siamese_segmentation_model

SRC = Path("/opt/stonewall/src")
# Backbone name -> upstream's fine-tuning config, which fixes the architecture.
CONFIGS = {
    "rn50": "cfg/dino_cv_rn50_budjbim_siamese.yaml",
    "wrn50": "cfg/dino_cv_wrn50_budjbim_siamese.yaml",
    "vitsmall16": "cfg/dino_cv_vitsmall16_budjbim_siamese.yaml",
}
AREAS = [f"area{i}" for i in range(1, 7)]
IMG_SIZE = 256
IMAGENET_MEAN = (0.485, 0.456, 0.406)
IMAGENET_STD = (0.229, 0.224, 0.225)


def build_backbone(cfg: dict) -> torch.nn.Module:
    """Build an encoder exactly as upstream's build_model(weight_mode='load') does, minus the load.

    The ViT is built without img_size, as in upstream's 'load' branch, so its
    position embedding has the shape the fine-tuned checkpoint was saved with.
    """
    arch = cfg["arch"]
    if arch in vits.__dict__:
        return vits.__dict__[arch](patch_size=cfg["patch_size"], drop_rate=0.1, attn_drop_rate=0.1, drop_path_rate=0.1)
    return torchvision_models.__dict__[arch](num_classes=0)


def build_model(backbone: str) -> tuple[torch.nn.Module, dict]:
    cfg = yaml.safe_load((SRC / CONFIGS[backbone]).read_text())
    encoders = [build_backbone(cfg), build_backbone(cfg)]
    model = siamese_segmentation_model(
        encoders, cfg["feature_indices"], cfg["feature_channels"], cfg["patch_size"], cfg["arch"]
    )
    return model, cfg


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def find_checkpoint(weights: Path, backbone: str, area: str) -> Path:
    """Locate <weights>/<backbone>/.../<area>/ckpt/best_val_epoch.pth and check it against SHA256SUMS."""
    hits = sorted((weights / backbone).rglob(f"{area}/ckpt/best_val_epoch.pth"))
    if len(hits) != 1:
        sys.exit(f"expected one {area}/ckpt/best_val_epoch.pth under {weights / backbone}, found {len(hits)}")
    ckpt = hits[0]
    sums = weights / "SHA256SUMS"
    if not sums.exists():
        sys.exit(f"{sums} is missing; a checkpoint is a pickle and is not loaded unchecked")
    expected = {}
    for line in sums.read_text().splitlines():
        digest, name = line.split(maxsplit=1)
        expected[name.lstrip("*")] = digest
    rel = str(ckpt.relative_to(weights))
    if rel not in expected:
        sys.exit(f"{rel} is not listed in {sums}")
    if sha256(ckpt) != expected[rel]:
        sys.exit(f"SHA-256 mismatch for {rel}")
    return ckpt


def load_checkpoint(model: torch.nn.Module, ckpt: Path) -> None:
    state = torch.load(ckpt, map_location="cpu", weights_only=False)["model_state_dict"]
    result = model.load_state_dict(state, strict=False)
    if result.missing_keys or result.unexpected_keys:
        sys.exit(
            f"checkpoint does not match the model: {len(result.missing_keys)} missing keys "
            f"(first: {result.missing_keys[:3]}), {len(result.unexpected_keys)} unexpected "
            f"(first: {result.unexpected_keys[:3]})"
        )


def predict(model, tiles: Path, out: Path, device: str, conf: float, sieve: int) -> tuple[int, int]:
    transform = T.Compose(
        [
            T.Resize(size=IMG_SIZE, interpolation=T.InterpolationMode.BICUBIC),
            T.ToTensor(),
            T.Normalize(IMAGENET_MEAN, IMAGENET_STD),
        ]
    )
    names = sorted(p.name for p in (tiles / "mhs").glob("*.tif"))
    missing = [n for n in names if not (tiles / "vat" / n).exists()]
    if not names or missing:
        sys.exit(f"{len(names)} MHS tiles; {len(missing)} without a VAT tile of the same name")
    out.mkdir(parents=True, exist_ok=True)
    kept = 0
    with torch.no_grad():
        for name in names:
            views = [
                transform(T.ToPILImage()(tiff_to_arr(tiles / v / name, v))).unsqueeze(0).to(device)
                for v in ("mhs", "vat")
            ]
            pred = (model(views).sigmoid().squeeze(0) > conf).float()
            if pred.max() != 1.0:
                continue
            target = out / name
            with rio.open(tiles / "mhs" / name) as tiff:
                pred = TF.resize(pred, size=[tiff.height, tiff.width], interpolation=T.InterpolationMode.NEAREST)
                pred = pred.cpu().numpy().astype(np.uint8)
                # Upstream's (C, H, W) -> (H, W, C); C is 1, so a reshape is a transpose here.
                pred = pred.reshape(pred.shape[1], pred.shape[2], pred.shape[0])
                arr_to_tiff(pred, output=target, crs=tiff.crs, transform=tiff.transform)
            gdal_sieve(src_filename=str(target), dst_filename=str(target), threshold=sieve, connectedness=8)
            with rio.open(target) as written:
                if np.all(written.read() == 0):
                    target.unlink()
                    continue
            kept += 1
    return len(names), kept


def main() -> None:
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("--tiles", type=Path, required=True, help="folder holding mhs/ and vat/ GeoTIFF tiles")
    p.add_argument("--out", type=Path, required=True, help="folder for the wall masks")
    p.add_argument("--weights", type=Path, default=Path("/weights"))
    p.add_argument("--backbone", choices=sorted(CONFIGS), default="wrn50")
    p.add_argument(
        "--area", choices=AREAS, default="area3", help="which held-out-area checkpoint (upstream default area3)"
    )
    p.add_argument("--conf", type=float, default=0.5)
    p.add_argument("--sieve", type=int, default=100)
    p.add_argument("--device", default="cuda" if torch.cuda.is_available() else "cpu")
    args = p.parse_args()

    model, _ = build_model(args.backbone)
    ckpt = find_checkpoint(args.weights, args.backbone, args.area)
    load_checkpoint(model, ckpt)
    model.eval().to(args.device)
    total, kept = predict(model, args.tiles, args.out, args.device, args.conf, args.sieve)
    print(f"{args.backbone} {args.area}: {total} tile pairs, {kept} with walls after sieving -> {args.out}")


if __name__ == "__main__":
    main()
