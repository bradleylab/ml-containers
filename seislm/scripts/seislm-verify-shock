#!/usr/bin/env python3
"""Reproduce SeisLM's nine-class foreshock-aftershock result at station NRCA.

Liu et al. (2024), arXiv:2410.15765v1, Figure 6 (page 9) gives the test-fold
confusion matrices for the 2016 Norcia sequence, FEQ1-FEQ4, Visso, AEQ1-AEQ4,
with each panel's accuracy in its title: SeisLM-base 65.11 %, SeisLM-large
74.22 % (ConvNet baseline 58.33 %). The paper has no table of downstream
results; these three titles are its only exact downstream numbers.

"Acc" in those titles is the mean of the nine diagonal entries of the
row-normalized confusion matrix after rounding each to a whole percent, which is
how upstream's demo notebook (demo_seislm_foreshock_aftershock_classification)
computes it; all three published values are a whole number divided by nine.
The script reports that figure, the unrounded macro recall, and Lightning's
test accuracy.

Training follows upstream's run script (src/foreshock_aftershock/
foreshock_aftershock_run.py) and its config for each model
(seisLM/configs/foreshock_aftershock/seisLM_{base,large}_shock_classifier.json),
with upstream's data pipeline, model classes and seed, on one GPU. SMOKE.md
lists the points upstream leaves open.

  seislm-verify-shock stage DATA                       download and unpack the NRCA data
  seislm-verify-shock run DATA RUN {base,large}        fine-tune, then test last.ckpt
  seislm-verify-shock selfcheck                        the same pipeline, offline, on synthetic data
"""

import argparse
import importlib.metadata as im
import json
import os
import subprocess
import sys
import tempfile
import zipfile
from datetime import datetime, timedelta, timezone
from pathlib import Path

import gdown
import lightning
import ml_collections
import numpy as np
import pandas as pd
import torch
from lightning.pytorch import seed_everything
from lightning.pytorch.callbacks import LearningRateMonitor, ModelCheckpoint
from lightning.pytorch.loggers import CSVLogger
from seisLM.model.foundation.pretrained_models import LitMultiDimWav2Vec2
from seisLM.model.task_specific import foreshock_aftershock_models
from sklearn.metrics import confusion_matrix

from seislm_checkpoints import CHECKPOINTS, DEFAULT_WEIGHTS, sha256_file, verified_checkpoint

SEISLM_HOME = Path(os.environ.get("SEISLM_HOME", "/opt/seislm"))
SHOCK_CONFIGS = SEISLM_HOME / "seisLM" / "configs" / "foreshock_aftershock"
PRETRAIN_CONFIGS = SEISLM_HOME / "seisLM" / "configs" / "pretrain"

# Upstream's demo notebook downloads this Google Drive file and unzips it into
# data/foreshock_aftershock_NRCA/, where its data pipeline reads it.
DRIVE_FILE_ID = "1saaRH175pSFgl0zfQWFpedgj44pJKK3_"
ARCHIVE_NAME = "wetransfer_classify_generic_norcia-py_2024-06-24_1530.zip"
# The SHA-256 of the archive the lab staged. Unset until the first stage
# prints it; once recorded here, stage refuses any other archive.
NRCA_ARCHIVE_SHA256: str | None = None
# Pickled DataFrames despite the .csv suffix; upstream reads them with pd.read_pickle.
NRCA_FILES = ("dataframe_pre_NRCA.csv", "dataframe_visso_NRCA.csv", "dataframe_post_NRCA.csv")
UPSTREAM_DATA_SUBDIR = Path("data") / "foreshock_aftershock_NRCA"

NUM_CLASSES = 9
CLASS_NAMES = ("FEQ1", "FEQ2", "FEQ3", "FEQ4", "Visso", "AEQ1", "AEQ2", "AEQ3", "AEQ4")
# BASE_TRAINING_FRACTION in upstream's run script: the full training fold.
TRAIN_FRAC = 0.7
# Both configs train on 2 GPUs x 16 under DDP; upstream's demo notebook runs
# one GPU at 32, the same global batch. This runs the notebook's way.
GLOBAL_BATCH = 32
PUBLISHED_ACC = {"base": 65.11, "large": 74.22}

SELFCHECK_EVENTS_PER_CLASS = 20
SELFCHECK_SAMPLES = 3001
SELFCHECK_BATCH = 16


def stage(data_dir: Path) -> None:
    data_dir.mkdir(parents=True, exist_ok=True)
    archive = data_dir / ARCHIVE_NAME
    if not archive.exists():
        gdown.download(id=DRIVE_FILE_ID, output=str(archive), quiet=False)
    digest = sha256_file(archive)
    print(f"{archive.name}: {archive.stat().st_size:,} bytes, SHA-256 {digest}")
    if NRCA_ARCHIVE_SHA256 is None:
        print("NRCA_ARCHIVE_SHA256 is unset; record the value above in seislm-verify-shock")
    elif digest != NRCA_ARCHIVE_SHA256:
        raise SystemExit(f"archive SHA-256 does not match the recorded {NRCA_ARCHIVE_SHA256}")
    with zipfile.ZipFile(archive) as zf:
        zf.extractall(data_dir)
    # Reading the files runs their pickles, the same trust step as loading a checkpoint.
    for name in NRCA_FILES:
        df = pd.read_pickle(data_dir / name)
        print(
            f"{name}: {len(df)} traces, {df['source_id'].nunique()} events, "
            f"{len(df['Z_channel'].iloc[0])} samples per channel"
        )


def prepare_upstream_root(run_dir: Path, data_dir: Path) -> None:
    """Make run_dir the repository root that upstream's project_path expects.

    seisLM.utils.project_path runs `git rev-parse --show-toplevel` from the
    working directory at import time and reads the data from <root>/data and
    writes results under <root>/results. A fresh git repository in run_dir,
    with the data linked in, satisfies it without changing upstream's code.
    """
    run_dir.mkdir(parents=True, exist_ok=True)
    if not (run_dir / ".git").exists():
        subprocess.run(["git", "init", "-q", str(run_dir)], check=True)
    link = run_dir / UPSTREAM_DATA_SUBDIR
    link.parent.mkdir(parents=True, exist_ok=True)
    if not link.exists():
        link.symlink_to(data_dir.resolve(), target_is_directory=True)
    os.chdir(run_dir)
    # Upstream calls load_from_checkpoint without weights_only, and torch >= 2.6
    # then refuses the ConfigDict hyperparameters. This restores torch's earlier
    # default for calls that do not choose; the pretrained checkpoint has been
    # SHA-256-checked and the others are written by this run.
    os.environ["TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD"] = "1"


def shock_config(variant: str, pretrained_ckpt: Path) -> ml_collections.ConfigDict:
    config_file = SHOCK_CONFIGS / f"seisLM_{variant}_shock_classifier.json"
    config = ml_collections.ConfigDict(json.loads(config_file.read_text()))
    config.model_args.pretrained_ckpt_path = str(pretrained_ckpt)
    config.model_args.num_classes = NUM_CLASSES
    config.data_args.train_frac = TRAIN_FRAC
    config.data_args.batch_size = GLOBAL_BATCH
    config.trainer_args.devices = 1
    config.trainer_args.strategy = "auto"
    return config


def finetune(config: ml_collections.ConfigDict, run_dir: Path) -> dict:
    """Upstream's train_foreshock_aftershock with a CSV logger in place of W&B."""
    # The data pipeline imports seisLM.utils.project_path, which resolves the
    # repository root at import time, so it can only be imported once
    # prepare_upstream_root has set the working directory.
    from seisLM.data_pipeline import foreshock_aftershock_dataloaders as dataloaders

    seed_everything(config.get("seed", 42))
    loaders = dataloaders.prepare_foreshock_aftershock_dataloaders(
        num_classes=config.model_args.num_classes, **config.data_args
    )
    config.trainer_args.max_train_steps = config.trainer_args.max_epochs * len(loaders["train"])
    model = foreshock_aftershock_models.Wav2vec2ShockClassifierLit(
        model_config=config.model_args, training_config=config.trainer_args
    )
    checkpoints = ModelCheckpoint(
        monitor="val/loss", save_top_k=1, save_last=True, mode="min", filename="{epoch}-{step}"
    )
    trainer = lightning.Trainer(
        default_root_dir=run_dir / "results" / "models",
        logger=CSVLogger(run_dir / "results" / "models", name="shock_classifier"),
        callbacks=[LearningRateMonitor(logging_interval="step"), checkpoints],
        log_every_n_steps=min(50, len(loaders["train"]) // config.trainer_args.devices),
        devices=config.trainer_args.devices,
        strategy=config.trainer_args.strategy,
        accelerator=config.trainer_args.accelerator,
        max_epochs=config.trainer_args.max_epochs,
        enable_checkpointing=True,
    )
    # Upstream validates on the test fold during fit. Kept as written: it only
    # feeds the logs and the best-checkpoint pick, and the result is read from last.ckpt.
    trainer.fit(model, loaders["train"], loaders["test"])
    test_metrics = trainer.test(ckpt_path="last", dataloaders=loaders["test"])[0]
    return {
        "last_ckpt": checkpoints.last_model_path,
        "lightning_test_acc": test_metrics["test/acc"],
        "test_loader": loaders["test"],
    }


def confusion_percentages(last_ckpt: str, test_loader, device: str) -> np.ndarray:
    """Row-normalized confusion matrix in percent, as upstream's demo notebook computes it."""
    model = (
        foreshock_aftershock_models.Wav2vec2ShockClassifierLit.load_from_checkpoint(
            last_ckpt, load_pretrained=False, map_location=device
        )
        .to(device)
        .eval()
    )
    truth, pred = [], []
    with torch.no_grad():
        for x, y in test_loader:
            pred.append(model(x.to(device)).argmax(dim=1).cpu().numpy())
            truth.append(y.numpy())
    cm = confusion_matrix(np.concatenate(truth), np.concatenate(pred), labels=range(NUM_CLASSES))
    return 100 * cm.astype(float) / cm.sum(axis=1, keepdims=True)


def summarize(variant: str, cm_percent: np.ndarray, lightning_acc: float) -> dict:
    diagonal = np.rint(cm_percent).diagonal()
    return {
        "variant": variant,
        "published_acc_percent": PUBLISHED_ACC.get(variant),
        "acc_percent_as_published": round(float(diagonal.mean()), 2),
        "macro_recall_percent_unrounded": round(float(cm_percent.diagonal().mean()), 2),
        "lightning_test_acc_percent": round(100 * float(lightning_acc), 2),
        "per_class_recall_percent": dict(zip(CLASS_NAMES, diagonal.astype(int).tolist())),
        "confusion_percent_rounded": np.rint(cm_percent).astype(int).tolist(),
    }


def run(data_dir: Path, run_dir: Path, variant: str, weights: Path, max_epochs: int | None) -> None:
    assert torch.cuda.is_available(), "no GPU visible"
    pretrained = verified_checkpoint(weights, variant)
    run_dir = run_dir.resolve()
    prepare_upstream_root(run_dir, data_dir)
    # Upstream's __main__ sets these before training.
    torch.backends.cudnn.benchmark = True
    torch.backends.cudnn.deterministic = True
    torch.set_float32_matmul_precision("high")

    config = shock_config(variant, pretrained)
    if max_epochs is not None:
        config.trainer_args.max_epochs = max_epochs
    print(config)
    fit = finetune(config, run_dir)
    result = summarize(
        variant, confusion_percentages(fit["last_ckpt"], fit["test_loader"], "cuda"), fit["lightning_test_acc"]
    )
    result.update(
        gpu=torch.cuda.get_device_name(0),
        max_epochs=config.trainer_args.max_epochs,
        global_batch=GLOBAL_BATCH,
        pretrained_sha256=CHECKPOINTS[variant].sha256,
        versions={p: im.version(p) for p in ("torch", "lightning", "seisbench", "torchmetrics", "pandas")},
    )
    (run_dir / "result.json").write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps({k: v for k, v in result.items() if k != "confusion_percent_rounded"}, indent=2))
    print(
        f"SeisLM-{variant}: Acc {result['acc_percent_as_published']:.2f} % (published {PUBLISHED_ACC[variant]:.2f} %)"
    )


def synthetic_nrca(data_dir: Path) -> None:
    """Write pre/visso/post pickles with the columns upstream's pipeline reads, filled with noise."""
    rng = np.random.default_rng(0)
    data_dir.mkdir(parents=True, exist_ok=True)
    classes_per_file = (4, 1, 4)  # pre, visso, post, as upstream splits them
    source_id = 0
    start = datetime(2016, 8, 1, tzinfo=timezone.utc)
    for name, n_classes in zip(NRCA_FILES, classes_per_file):
        rows = []
        for _ in range(n_classes * SELFCHECK_EVENTS_PER_CLASS):
            origin = start + timedelta(hours=source_id)
            rows.append(
                {
                    **{f"{c}_channel": rng.standard_normal(SELFCHECK_SAMPLES) for c in "ENZ"},
                    "source_id": source_id,
                    "source_origin_time": origin.strftime("%Y-%m-%dT%H:%M:%S"),
                    "trace_start_time": origin.isoformat(),
                }
            )
            source_id += 1
        pd.DataFrame(rows).to_pickle(data_dir / name)


def random_pretrained_checkpoint(path: Path) -> None:
    """A Lightning checkpoint of a randomly initialized SeisLM-base, in the layout upstream loads."""
    config_file = PRETRAIN_CONFIGS / CHECKPOINTS["base"].pretrain_config
    torch.manual_seed(0)
    lit = LitMultiDimWav2Vec2(ml_collections.ConfigDict(json.loads(config_file.read_text())))
    torch.save(
        {
            "state_dict": lit.state_dict(),
            "hyper_parameters": dict(lit.hparams),
            "pytorch-lightning_version": lightning.__version__,
        },
        path,
    )


def selfcheck() -> None:
    """Fine-tune and evaluate for one epoch on the CPU, offline, with no staged data or weights."""
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        synthetic_nrca(tmp / "nrca")
        random_pretrained_checkpoint(tmp / "random_base.ckpt")
        run_dir = tmp / "run"
        prepare_upstream_root(run_dir, tmp / "nrca")
        config = shock_config("base", tmp / "random_base.ckpt")
        config.trainer_args.accelerator = "cpu"
        config.trainer_args.max_epochs = 1
        config.data_args.batch_size = SELFCHECK_BATCH
        config.data_args.num_workers = 0
        fit = finetune(config, run_dir)
        result = summarize(
            "base", confusion_percentages(fit["last_ckpt"], fit["test_loader"], "cpu"), fit["lightning_test_acc"]
        )
        assert len(result["confusion_percent_rounded"]) == NUM_CLASSES
        assert 0 <= result["lightning_test_acc_percent"] <= 100
        print("synthetic data, random weights, 1 epoch:", result["acc_percent_as_published"], "%")
    print("SELFCHECK OK")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="command", required=True)
    p_stage = sub.add_parser("stage", help="download and unpack upstream's NRCA data")
    p_stage.add_argument("data", type=Path)
    p_run = sub.add_parser("run", help="fine-tune and evaluate one SeisLM variant on a GPU")
    p_run.add_argument("data", type=Path)
    p_run.add_argument("run_dir", type=Path)
    p_run.add_argument("variant", choices=tuple(PUBLISHED_ACC))
    p_run.add_argument("--weights", type=Path, default=DEFAULT_WEIGHTS)
    p_run.add_argument("--max-epochs", type=int, help="override the config's max_epochs (debugging only)")
    sub.add_parser("selfcheck", help="offline pipeline check on synthetic data (image build)")
    args = ap.parse_args()

    if args.command == "stage":
        stage(args.data)
    elif args.command == "run":
        run(args.data, args.run_dir, args.variant, args.weights, args.max_epochs)
    else:
        selfcheck()
    return 0


if __name__ == "__main__":
    sys.exit(main())
