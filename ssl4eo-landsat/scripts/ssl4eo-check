#!/usr/bin/env python
"""Load every baked SSL4EO-L checkpoint and run a forward pass on it.

Each model is built through TorchGeo's own loader, so the check covers the
enum metadata (in_chans, band list), the file TorchGeo resolves in
TORCH_HOME, the strict key match TorchGeo asserts, and the weight's preset
transforms. The input is random uint8-range data at the benchmark patch size
(264 px), cropped to 224 px by those transforms. The build runs this with no
network, so a checkpoint missing from the bake fails here, not at first use.

    ssl4eo-check [cpu|cuda]      default: cuda when a GPU is visible
"""

import importlib.metadata as im
import sys

import torch
from torchgeo.models import (
    ResNet18_Weights,
    ResNet50_Weights,
    ViTSmall16_Weights,
    resnet18,
    resnet50,
    vit_small_patch16_224,
)

BUILDERS = {
    ResNet18_Weights: resnet18,
    ResNet50_Weights: resnet50,
    ViTSmall16_Weights: vit_small_patch16_224,
}
EXPECTED_CHECKPOINTS = 30
# SSL4EO-L benchmark patches are 264 x 264 px (torchgeo SSL4EOLBenchmark).
PATCH_PX = 264
BATCH = 2


def first_layer_in_channels(model: torch.nn.Module) -> int:
    """Input channel count of the stem, for ResNet and ViT alike."""
    stem = model.conv1 if hasattr(model, "conv1") else model.patch_embed.proj
    return stem.in_channels


def check(weights, builder, device: str) -> tuple[int, ...]:
    bands = weights.meta["bands"]
    assert weights.meta["in_chans"] == len(bands), (
        f"{weights}: in_chans {weights.meta['in_chans']} != {len(bands)} bands"
    )
    # num_classes=0 drops the classifier, which SSL4EO-L does not ship, so the
    # output is the pooled embedding and every loaded parameter is exercised.
    model = builder(weights=weights, num_classes=0).to(device).eval()
    assert first_layer_in_channels(model) == len(bands)

    x = torch.randint(0, 256, (BATCH, len(bands), PATCH_PX, PATCH_PX)).float()
    x = weights.transforms(x).to(device)
    with torch.inference_mode():
        y = model(x)
    assert y.shape == (BATCH, model.num_features), f"{weights}: {tuple(y.shape)}"
    assert torch.isfinite(y).all(), f"{weights}: non-finite output"
    assert y.std() > 0, f"{weights}: constant output"
    return tuple(y.shape)


def main() -> None:
    device = sys.argv[1] if len(sys.argv) > 1 else (
        "cuda" if torch.cuda.is_available() else "cpu"
    )
    print(
        "torch", torch.__version__, "| cuda build", torch.version.cuda,
        "| torchvision", im.version("torchvision"),
        "| torchgeo", im.version("torchgeo"),
        "| timm", im.version("timm"),
    )
    if device == "cuda":
        print("device", torch.cuda.get_device_name(0),
              "| capability", torch.cuda.get_device_capability(0))

    n = 0
    for enum, builder in BUILDERS.items():
        for w in enum:
            if w.meta.get("dataset") != "SSL4EO-L":
                continue
            shape = check(w, builder, device)
            print(f"ok  {enum.__name__}.{w.name:28s} in_chans={w.meta['in_chans']:>2d} "
                  f"-> {shape}", flush=True)
            n += 1
    assert n == EXPECTED_CHECKPOINTS, f"checked {n}, expected {EXPECTED_CHECKPOINTS}"
    print(f"SSL4EO-L CHECK OK: {n} checkpoints on {device}")


if __name__ == "__main__":
    main()
