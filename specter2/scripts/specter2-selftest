#!/usr/bin/env python
"""Run specter2-embed on the model card's two example papers and one query, offline.

Checks that the baked base model and every adapter load and that embeddings
come out finite and 768-wide. It prints the query-to-paper cosine similarities
for the record; it does not judge them.
"""

import json
import subprocess
import tempfile
from pathlib import Path

import numpy as np
from specter2_weights import ADAPTERS

HIDDEN = 768
# The two papers in the model card's usage example.
PAPERS = [
    {"id": "bert", "title": "BERT", "abstract": "We introduce a new language representation model called BERT"},
    {
        "id": "transformer",
        "title": "Attention is all you need",
        "abstract": " The dominant sequence transduction models are based on complex recurrent or convolutional neural networks",
    },
]
QUERY = "language representation model"


def normalize(m: np.ndarray) -> np.ndarray:
    return m / np.linalg.norm(m, axis=1, keepdims=True)


def run(args: list[str], out: Path) -> np.lib.npyio.NpzFile:
    subprocess.run(["specter2-embed", *args, "--out", str(out)], check=True)
    result = np.load(out)
    emb = result["embeddings"]
    assert emb.dtype == np.float32 and emb.shape[1] == HIDDEN and np.isfinite(emb).all(), emb.shape
    return result


def main() -> None:
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        papers = tmp / "papers.jsonl"
        papers.write_text("".join(json.dumps(p) + "\n" for p in PAPERS))
        queries = tmp / "queries.txt"
        queries.write_text(QUERY + "\n")

        paper_emb = {}
        for adapter in ADAPTERS:
            out = run(["--papers", str(papers), "--adapter", adapter, "--device", "cpu"], tmp / f"{adapter}.npz")
            assert list(out["ids"]) == [p["id"] for p in PAPERS]
            paper_emb[adapter] = out["embeddings"]
        query_emb = run(["--queries", str(queries), "--device", "cpu"], tmp / "query.npz")["embeddings"]
        # Identical vectors from two adapters would mean neither was applied.
        for adapter in ADAPTERS[1:]:
            assert not np.allclose(paper_emb[adapter], paper_emb[ADAPTERS[0]]), f"{adapter} = {ADAPTERS[0]}"

        cos = normalize(query_emb) @ normalize(paper_emb["proximity"]).T
        print("cosine, adhoc_query query vs proximity papers:", dict(zip([p["id"] for p in PAPERS], cos[0].round(4))))
    print("SELFTEST OK")


if __name__ == "__main__":
    main()
